  "novel_formulations": {
    "consensus_voting_matrix": {
      "formula": "votes = sum(I(y_m == -1)) for m in [IsolationForest, LOF, OneClassSVM]",
      "categories": {
        "0": {
          "severity": "normal",
          "description": "All 3 models agree nominal"
        },
        "1": {
          "severity": "weak_anomaly",
          "description": "1 model flag (minor edge / noise)"
        },
        "2": {
          "severity": "consensus_anomaly",
          "description": "2 models agree (genuine deviation)"
        },
        "3": {
          "severity": "strong_anomaly",
          "description": "3 models unanimous consensus (critical failure)"
        }
      },
      "source": "backend/ml_engine.py:L235-L243",
      "status": "verified_from_code"
    },
    "deterministic_confidence_score": {
      "base_confidence": {
        "0_votes": 0.0,
        "1_vote": 50.0,
        "2_votes": 75.0,
        "3_votes": 90.0
      },
      "z_score_bonus_formula": "bonus = min(10.0, max(0.0, (max_z_score - 2.0) * 3.0))",
      "total_confidence_formula": "confidence = min(100.0, base_confidence + bonus), rounded to 1 decimal place",
      "source": "backend/ml_engine.py:L197-L218",
      "status": "verified_from_code"
    },
    "feature_contribution_weighting": {
      "formula": "w_i = (|z_i| / sum(|z_j|)) * 100%",
      "source": "backend/ml_engine.py:L252-L265",
      "status": "verified_from_code"
    },
    "dynamic_explanation_generation": {
      "template": "{primary_feature} (value: {val}) significantly deviated from normal baseline (z-score: {max_z:.2f}) and was classified as anomalous by {votes} of 3 models ({models_str}).",
      "source": "backend/ml_engine.py:L268-L287",
      "status": "verified_from_code"
    },
    "episode_windowing_algorithm": {
      "gap_threshold": 2,
      "rule": "Group consecutive or near-consecutive anomalous records where (p[index] - last_p[index]) <= (gap_threshold + 1), i.e. <= 3 index distance (allowing up to 2 normal frames between)",
      "duration_calculation": "abs(end_ts - start_ts); if duration == 0: duration = round(len(ep_records) * 0.3, 2)",
      "peak_metrics": "max observed value per affected feature during episode",
      "normal_ranges": "trip-wide baseline 25th percentile (Q1), 75th percentile (Q3), min, max, median",
      "source": "backend/ml_engine.py:L446-L463, L510-L548",
      "status": "verified_from_code"
